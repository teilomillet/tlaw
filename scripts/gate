#!/bin/sh
# The push gate: everything that must hold before main moves.
#
# One visible script, two callers — .githooks/pre-push runs it on this
# machine before every push, and .github/workflows/ci.yml runs the same
# commands on every push and pull request. Local and remote enforcement
# share one command list because they call the same file.
#
# What it enforces, in order of cheapest failure first:
#   1. the committed dependency lock still matches pyproject.toml;
#   2. pending changelog fragments are valid and renderable;
#   3. ruff lint and formatting;
#   4. the full property suite;
#   5. independent symbolic contracts are confirmed over all paths;
#   6. tlaw's core self-laws and flat example laws still pass; and
#   7. the flat examples still kill their generated mutants — the repo
#      dogfoods its own strength meter on every push.
set -eu
cd "$(git rev-parse --show-toplevel)"

uv lock --check
uv run towncrier build --draft >/dev/null
uv run ruff check .
uv run ruff format --check .
uv run pytest -q
./scripts/crosshair
# Core self-laws stay in the fast gate. Their exhaustive mutation campaign
# lives in scripts/core-evidence and a dedicated CI workflow.
uv run tlaw check self_laws/
# Folder discovery checks every example's laws in one command, which also
# dogfoods `tlaw check <folder>` on every push.
uv run tlaw check examples/
uv run tlaw mutate examples/batch_packer/laws.py \
    examples/batch_packer/implementation.py
uv run tlaw mutate examples/score_weights/laws.py \
    examples/score_weights/implementation.py \
    --equivalents examples/score_weights/equivalents.toml
uv run tlaw mutate examples/rescale/laws.py \
    examples/rescale/implementation.py \
    --equivalents examples/rescale/equivalents.toml

echo "gate: every check passed"
